# vi: ft=swayconfig

focus_follows_mouse no
smart_borders on
default_border pixel
gaps inner 10
smart_gaps on

input "type:pointer" {
    accel_profile flat
}

input "type:touchpad" {
    click_method clickfinger
    middle_emulation enabled
    natural_scroll enabled
    scroll_factor 0.2
    tap enabled
}

for_window [class=".*"] inhibit_idle fullscreen

exec autotiling
exec fcitx5 -d
# TODO: Use programs.noctalia after upgrading to NixOS 26.11.
exec noctalia
exec soteria

include ~/.config/sway/config.d/*
include /etc/sway/config.d/*
