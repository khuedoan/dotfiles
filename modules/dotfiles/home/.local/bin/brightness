#!/bin/sh

set -eu

tag='string:x-canonical-private-synchronous:brightness'

brightnessctl -q -n set "$1"

current="$(brightnessctl get)"
maximum="$(brightnessctl max)"
value=$((current * 100 / maximum))

notify-send \
    --expire-time 1000 \
    --hint "$tag" \
    --hint "int:value:$value" \
    "Brightness: $value%"
