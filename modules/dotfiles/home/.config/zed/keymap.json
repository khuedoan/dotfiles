[
  // Match Kitty pane controls while a terminal has focus.
  {
    "context": "Terminal",
    "bindings": {
      "alt-enter": "pane::SplitRight",
      "alt-shift-enter": "pane::SplitDown",
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-k": "workspace::ActivatePaneUp",
      "alt-l": "workspace::ActivatePaneRight",
      "alt-shift-h": "workspace::SwapPaneLeft",
      "alt-shift-j": "workspace::SwapPaneDown",
      "alt-shift-k": "workspace::SwapPaneUp",
      "alt-shift-l": "workspace::SwapPaneRight",
      "alt-q": "pane::CloseActiveItem",
      "alt-shift-f": "workspace::ToggleZoom"
    }
  },

  // Workspace leader: command mode or a view without text input.
  // Keep Space available in editors, prompts, terminals, and pending operators.
  {
    "context": "((VimControl && vim_mode != operator) || (!Editor && !Terminal)) && !menu",
    "bindings": {
      "space": null,

      // Navigation
      "space space": "file_finder::Toggle",
      "space f g": "file_finder::Toggle",
      "space ,": "tab_switcher::OpenInActivePane",

      // Git
      "space g s": "git_panel::ToggleFocus",
      "space g d": "git::ViewUnstagedChanges",
      "space g D": "git::ViewStagedChanges",
      "space g l": "git_graph::Open",

      // Projects and tasks
      "space p p": "projects::OpenRecent",
      "space p >": "projects::OpenRecent",
      "space p f": "file_finder::Toggle",
      "space p b": "tab_switcher::Toggle",
      "space p s": "workspace::SaveAll",
      "space p .": "project_panel::ToggleFocus",
      "space p c": "task::Spawn",
      "space p R": "task::Rerun",
      "space p T": "task::Spawn"
    }
  },

  // Editing in normal and visual modes.
  {
    "context": "VimControl && vim_mode != operator && !menu",
    "bindings": {
      "g z": "vim::PushAddSurrounds"
    }
  },

  // Commands that act on the current editor or pane.
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      // Clipboard
      "space y F": "workspace::CopyPath",
      "space y f": "workspace::CopyRelativePath",

      // Buffers
      "space b d": "pane::CloseActiveItem",
      "space p k": "pane::CloseAllItems",

      // Git
      "space g b": "git::Blame",
      "space g h b": "git::OpenFilePermalink",
      "space g o": "editor::ToggleAllDiffHunks",

      // Search and replace
      "space s r": ["buffer_search::Deploy", { "replace_enabled": true }],
      "space s R": ["pane::DeploySearch", { "replace_enabled": true }],
      "space /": "pane::DeploySearch",
      "space ?": "pane::DeploySearch",

      // The project panel substitutes for Oil.
      "-": "pane::RevealInProjectPanel",
      "_": "project_panel::ToggleFocus",

      // Formatting and surround
      "space c f": "editor::Format",
      "r z": ["vim::PushChangeSurrounds", {}]
    }
  },

  // Selection commands have different behavior from normal-mode commands.
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "space y": ["workspace::SendKeystrokes", "\" + y"],
      "space c f": "editor::FormatSelections"
    }
  },

  // Sneak is a directional substitute for Leap.
  {
    "context": "VimControl && !menu",
    "bindings": {
      "s": "vim::PushSneak"
    }
  },

  // Match mini.surround's delete operator.
  {
    "context": "vim_operator == d && !menu",
    "bindings": {
      "z": "vim::PushDeleteSurrounds"
    }
  }
]
